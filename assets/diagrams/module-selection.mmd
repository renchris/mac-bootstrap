  LITE --> hooks["hooks<br/><i>lifecycle hooks</i>"]
  LITE --> panes["pane_equalize<br/><i>⌘⇧E evens panes</i>"]
  STD --> handoff["handoff<br/><i>self-recycling /handoff</i>"]
  STD --> rewrite["rewrite_model<br/><i>local rewrite model</i>"]
  FULL --> voiceink["voiceink<br/><i>local VoiceInk build</i>"]
